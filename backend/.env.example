# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/busyway?retryWrites=true&w=majority&appName=Cluster0
# Legacy alias (optional). The code reads MONGODB_URI first, then falls back to MONGO_URI.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/busyway?retryWrites=true&w=majority&appName=Cluster0

# JWT secret keys (use long random strings in production)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# CORS - comma separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Bus considered OFFLINE if no location update received within this many seconds
OFFLINE_THRESHOLD_SECONDS=30
